PREFER_LIVE=true
USE_LATEST_NEWS=true
MOBILE_ALERTS_ENABLED=true
TWELVE_DATA_API_KEY=
GEMINI_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=
EMAIL_APP_PASSWORD=
RECEIVER_EMAIL=tareekh39@gmail.com

# Optional actual BTC spot ETF net-flow input.
# CSV columns: date,ticker,flow_usd OR date,ticker,flow_musd
# If blank, NERO uses the price/volume ETF proxy fallback.
BTC_ETF_FLOW_CSV_PATH=
BTC_ETF_FLOW_CSV_URL=

# Optional official Gold real-yield input.
# CSV columns: date,DGS10,T10YIE OR date,real_yield
# If blank, NERO uses the yfinance real-yield proxy fallback.
GOLD_REAL_YIELD_CSV_PATH=
GOLD_REAL_YIELD_CSV_URL=

# Optional BTC structural model inputs.
# BTC_BLOCK_HEIGHT improves precision; otherwise NERO estimates from genesis time.
# BTC_MINER_COST_FLOOR is optional explanatory context, not a trading rule.
BTC_BLOCK_HEIGHT=
BTC_MINER_COST_FLOOR=
